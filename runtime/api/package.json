{
  "name": "founda-dock-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Founda Dock Station runtime — Android/Termux-hosted API, terminal engine and service supervisor.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
